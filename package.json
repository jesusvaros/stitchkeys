{
  "name": "stitchkeys",
  "version": "0.1.0",
  "description": "A keyboard of stitches for writing crochet and knitting rows on a phone: tap the count, then the stitch. Counts every row and checks it against the one before. US, UK and Spanish terms.",
  "license": "MIT",
  "author": "Jesús Varos",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jesusvaros/stitchkeys.git"
  },
  "homepage": "https://jesusvaros.github.io/stitchkeys/",
  "bugs": {
    "url": "https://github.com/jesusvaros/stitchkeys/issues"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./react/styles.css": "./dist/react/styles.css"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cp src/react/styles.css dist/react/styles.css",
    "test": "vitest run",
    "prepublishOnly": "npm test && npm run build",
    "demo": "vite demo --port 5175",
    "demo:build": "vite build demo --base ./ --outDir ../demo-dist --emptyOutDir",
    "typecheck": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "keywords": [
    "amigurumi",
    "crochet",
    "keyboard",
    "knit",
    "knitting",
    "pattern",
    "react",
    "row-counter",
    "stitch",
    "stitch-count",
    "yarn"
  ]
}
